DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?pgbouncer=true&connection_limit=1&schema=creatorhive"
# Direct connection for migrations (bypasses pgbouncer; use same HOST/PORT/DB but no pgbouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=creatorhive"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="supabase-service-role-key"
# Environment (production | development | preview)
NEXT_PUBLIC_ENVIRONMENT="development"
VERCEL_ENV="development"
# Set AUTH_TRUST_HOST=true when deploying to Vercel for auth callbacks
AUTH_TRUST_HOST="false"

# Auth.js — base URL (must match dev server; use http://127.0.0.1:3000 for dev:local)
AUTH_URL="http://127.0.0.1:3000"
NEXTAUTH_URL="http://127.0.0.1:3000"

# Auth.js — secret (generate: openssl rand -base64 32)
AUTH_SECRET="generate-with-openssl"
NEXTAUTH_SECRET="generate-with-openssl"

OPENAI_API_KEY="your-openai-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."
APP_URL="http://localhost:3000"

# Optional: override admin seed email (default: admin@creatorhive.test)
# SEED_ADMIN_EMAIL="your-admin@company.com"

# Optional: show Advanced settings (service status) in production builds
# NEXT_PUBLIC_SETTINGS_DEV_TOOLS=1

# Client hero — Google Calendar appointment schedule URL (opens in new tab). If unset, mailto:ajil@creatorhive.ae is used.
# NEXT_PUBLIC_ADVISOR_BOOKING_URL="https://calendar.google.com/calendar/appointments/schedules/..."
