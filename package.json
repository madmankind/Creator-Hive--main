{
  "name": "creator-hive-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "echo '→ Next.js dev (default: localhost:3000)'",
    "predev:local": "echo '→ Next.js dev:local | host 127.0.0.1 | port 3000'",
    "dev": "next dev",
    "dev:local": "next dev --webpack -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx --tsconfig tsconfig.json prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "seed:creators": "tsx scripts/seed-creators.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.1",
    "@tanstack/react-query": "^5.85.0",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "fuse.js": "^7.1.0",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.539.0",
    "next": "16.1.4",
    "next-auth": "5.0.0-beta.30",
    "next-seo": "^6.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.1.2",
    "rss-parser": "^3.13.0",
    "stripe": "^17.7.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "webpack-filter-warnings-plugin": "^1.2.1",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,css,md}": [
      "prettier --write",
      "next lint --fix --file"
    ]
  }
}
