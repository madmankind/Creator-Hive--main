// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Critical for migrations to work
}

enum HireType {
  PROJECT
  MONTHLY
  HOURLY
}

enum UsageRightsTier {
  NONE
  STANDARD
  FULL
  BUYOUT
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  campaignFilesUploaded CampaignFile[]
  walletTransactions    WalletTransaction[]
  id                    String              @id @default(cuid())
  email                 String              @unique
  name                  String?
  role                  UserRole            @default(CREATOR)
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  agencyAccount   AgencyAccount?
  creatorProfile  CreatorProfile?
  accounts        Account[]
  sessions        Session[]
  bookingRequests BookingRequest[]
  pods            PodSelection[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SignupApplication {
  id        String   @id @default(cuid())
  role      UserRole
  email     String
  whatsapp  String?
  instagram String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
  @@map("signup_applications")
}

model CampaignPodSelectionConfig {
  id               String          @id @default(cuid())
  campaignId       String
  creatorProfileId String
  hireType         HireType        @default(PROJECT)
  startDate        DateTime?
  endDate          DateTime?
  estimatedDays    Int?
  hours            Int?
  months           Int?
  dayRate          Int?
  hourlyRate       Int?
  monthlyRate      Int?
  usageRightsTier  UsageRightsTier @default(NONE)
  usageRightsFee   Int?
  lineTotal        Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorProfileId])
  @@index([campaignId])
  @@index([creatorProfileId])
  @@map("campaign_pod_selection_configs")
}

// ============================================
// AGENCY & TALENT MANAGEMENT
// ============================================

model AgencyAccount {
  walletTransactions WalletTransaction[]
  id                 String              @id @default(cuid())
  userId             String              @unique
  name               String
  website            String?
  location           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creators        CreatorProfile[]
  campaigns       Campaign[]
  bookingRequests BookingRequest[]

  @@index([userId])
  @@map("agency_accounts")
}

model CreatorProfile {
  walletTransactions     WalletTransaction[]
  id                     String                 @id @default(cuid())
  userId                 String?                @unique
  agencyId               String?
  name                   String
  instagram              String?
  bio                    String?                @db.Text
  hourlyRate             Int?
  dayRate                Int?
  skills                 String[] // Array of skill strings
  niches                 String[] // Array of niche strings
  location               String?
  avatarUrl              String?
  portfolioUrl           String?
  displayName            String?               // Public alias shown to clients (privacy layer)
  fullName               String?               // Legal/real name (internal only)
  qualityScore           Int?                  // 0–15 vetting score
  talentStatus           String                @default("pending") // "pending" | "active" | "paused" | "rejected"
  source                 String?               // "form" | "manual" | "scraped"
  isVerified             Boolean                @default(false)
  isActive               Boolean                @default(true)
  stripeAccountId        String?                @unique
  stripeOnboardingStatus StripeOnboardingStatus @default(NOT_STARTED)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // Relations
  agency                      AgencyAccount?               @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  user                        User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns                   CampaignTalent[]
  messages                    Message[]                    @relation("CreatorMessages")
  invoices                    Invoice[]
  invites                     CampaignInvite[]
  campaignPodSelectionConfigs CampaignPodSelectionConfig[]

  @@index([userId])
  @@index([agencyId])
  @@index([instagram])
  @@index([isActive])
  @@map("creator_profiles")
}

// ============================================
// CAMPAIGNS & PROJECTS
// ============================================

model Campaign {
  id                 String              @id @default(cuid())
  agencyId           String
  title              String
  brief              String              @db.Text // Legacy: kept for backward compatibility
  status             CampaignStatus      @default(DRAFT)
  startDate          DateTime?
  dueDate            DateTime?
  budget             Int? // In cents
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]

  // Relations
  agency                      AgencyAccount                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  talents                     CampaignTalent[]
  messages                    Message[]
  invoices                    Invoice[]
  pod                         CampaignPod?
  invites                     CampaignInvite[]
  files                       CampaignFile[]
  campaignPodSelectionConfigs CampaignPodSelectionConfig[]
  metrics                     CampaignMetric[]
  payments                    CampaignPayment[]
  campaignBrief               CampaignBrief?

  @@index([agencyId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignBrief {
  id                String      @id @default(cuid())
  campaignId        String      @unique
  version           Int         @default(1)
  status            BriefStatus @default(DRAFT)
  isLocked          Boolean     @default(false)
  lockedAt          DateTime?
  sentAt            DateTime?
  
  // Audit fields
  lastEditedBy      String?     // User ID or name (string for dev compatibility)
  lastEditedByName   String?     // User name for display
  
  // Brief sections
  primaryObjective  String?     // awareness | consideration | conversion
  keyMessage        String?     @db.VarChar(280) // 280 chars max
  creativeDirection Json?        // Checkbox-driven + optional notes
  mandatoryRequirements String?  @db.Text
  approvalRules     String?     @db.Text
  postingRules      String?     @db.Text
  
  // Attachments (references to CampaignFile)
  attachmentIds     String[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([isLocked])
  @@index([status])
  @@map("campaign_briefs")
}

model CampaignTalent {
  id         String               @id @default(cuid())
  campaignId String
  talentId   String
  status     CampaignTalentStatus @default(ASSIGNED)
  rate       Int? // Override rate for this campaign (in cents)
  notes      String?              @db.Text
  assignedAt DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  // Relations
  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  talent   CreatorProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, talentId])
  @@index([campaignId])
  @@index([talentId])
  @@index([status])
  @@map("campaign_talents")
}

model CampaignPod {
  id         String   @id @default(cuid())
  campaignId String   @unique
  talentIds  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_pods")
}

model CampaignInvite {
  id               String               @id @default(cuid())
  campaignId       String
  creatorProfileId String
  status           CampaignInviteStatus @default(PENDING)
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorProfileId])
  @@index([campaignId])
  @@index([creatorProfileId])
  @@map("campaign_invites")
}

model CampaignFile {
  id             String   @id @default(cuid())
  campaignId     String
  uploaderUserId String
  storageBucket  String
  storagePath    String   @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([uploaderUserId])
  @@map("campaign_files")
}

model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime
  views       Int      @default(0)
  reach       Int      @default(0)
  engagements Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
  @@map("campaign_metrics")
}

model CampaignPayment {
  id         String        @id @default(cuid())
  campaignId String
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(COMMITTED)
  dueDate    DateTime
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([dueDate])
  @@map("campaign_payments")
}

model WalletTransaction {
  id               String                @id @default(cuid())
  userId           String
  creatorProfileId String?
  agencyAccountId  String?
  campaignId       String?
  type             WalletTransactionType
  direction        WalletDirection
  amount           Int
  currency         String
  status           WalletStatus
  stripeObjectType String
  stripeObjectId   String
  metadata         Json?
  createdAt        DateTime              @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator  CreatorProfile? @relation(fields: [creatorProfileId], references: [id], onDelete: SetNull)
  agency   AgencyAccount?  @relation(fields: [agencyAccountId], references: [id], onDelete: SetNull)
  campaign Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([creatorProfileId])
  @@index([agencyAccountId])
  @@index([campaignId])
  @@index([stripeObjectId])
  @@map("wallet_transactions")
}

model BookingRequest {
  id           String        @id @default(cuid())
  userId       String
  agencyId     String?
  bookingType  BookingType   @default(SHORT)
  startDate    String?
  budgetRange  String?
  description  String        @db.Text
  contactEmail String
  talentIds    String[]
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency AgencyAccount? @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agencyId])
  @@map("booking_requests")
}

model PodSelection {
  id        String   @id @default(cuid())
  userId    String
  talentIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
  @@map("pod_selections")
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id          String   @id @default(cuid())
  campaignId  String?
  senderId    String // CreatorProfile ID
  recipientId String? // AgencyAccount ID or CreatorProfile ID
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  campaign Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sender   CreatorProfile @relation("CreatorMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================
// FINANCIAL
// ============================================

model Invoice {
  id            String        @id @default(cuid())
  campaignId    String?
  talentId      String
  agencyId      String?
  amount        Int // In cents
  currency      String        @default("USD")
  status        InvoiceStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  invoiceNumber String        @unique
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  campaign    Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  talent      CreatorProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([campaignId])
  @@index([talentId])
  @@index([agencyId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Transaction {
  id          String            @id @default(cuid())
  invoiceId   String?           @unique
  amount      Int // In cents
  currency    String            @default("USD")
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String?           @db.Text
  metadata    Json? // Additional transaction data
  processedAt DateTime?
  createdAt   DateTime          @default(now())

  // Relations
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  AGENCY
  CREATOR
  ADMIN
}

enum CampaignStatus {
  PROVISIONAL              // Talent selected, awaiting acceptance
  CONFIRMED_BRIEF_PENDING  // Talent accepted, brief not yet sent
  BRIEF_SENT               // Brief sent to talent, awaiting content
  IN_PROGRESS              // Content submitted, in production
  COMPLETED
  CANCELLED
  DRAFT                    // Legacy: kept for backward compatibility
  ACTIVE                   // Legacy: kept for backward compatibility
}

enum CampaignTalentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REFUND
  FEE
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BookingType {
  SHORT
  LONG
}

enum BookingStatus {
  PENDING
  REVIEWING
  CONFIRMED
}

enum CampaignInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum StripeOnboardingStatus {
  NOT_STARTED
  PENDING
  COMPLETE
}

enum WalletTransactionType {
  PAYMENT_INTENT
  TRANSFER
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum WalletStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentStatus {
  COMMITTED
  INVOICED
  PAID
}

enum BriefStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}
