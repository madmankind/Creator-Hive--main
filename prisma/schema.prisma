generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String               @id @default(cuid())
  email                 String               @unique
  name                  String?
  role                  UserRole             @default(CREATOR)
  emailVerified         DateTime?
  image                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  legalAcceptedAt       DateTime?
  legalVersion          String?
  accounts              Account[]
  advisorRequests       AdvisorRequest[]
  agencyAccount         AgencyAccount?
  bookingRequests       BookingRequest[]
  campaignFilesUploaded CampaignFile[]
  creatorProfile        CreatorProfile?
  creatorShopProjects   CreatorShopProject[]
  discoveryBrief        DiscoveryBrief?
  pods                  PodSelection?
  sessions              Session[]
  userAgreements        UserAgreement[]
  walletTransactions    WalletTransaction[]

  @@index([email])
  @@map("users")
}

model UserAgreement {
  id           String              @id @default(cuid())
  userId       String
  agreementRef String              @unique
  version      Int                 @default(1)
  status       UserAgreementStatus @default(GENERATED)
  storagePath  String?
  storageUrl   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agreementRef])
  @@index([status])
  @@map("user_agreements")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SignupApplication {
  id        String   @id @default(cuid())
  role      UserRole
  email     String
  whatsapp  String?
  instagram String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
  @@map("signup_applications")
}

model CampaignPodSelectionConfig {
  id               String          @id @default(cuid())
  campaignId       String
  creatorProfileId String
  hireType         HireType        @default(PROJECT)
  startDate        DateTime?
  endDate          DateTime?
  estimatedDays    Int?
  hours            Int?
  months           Int?
  dayRate          Int?
  hourlyRate       Int?
  monthlyRate      Int?
  usageRightsTier  UsageRightsTier @default(NONE)
  usageRightsFee   Int?
  lineTotal        Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  campaign         Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfile   CreatorProfile  @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorProfileId])
  @@index([campaignId])
  @@index([creatorProfileId])
  @@map("campaign_pod_selection_configs")
}

model AgencyAccount {
  id                  String               @id @default(cuid())
  userId              String               @unique
  name                String
  website             String?
  location            String?
  industry            String?
  primaryMarket       String?
  preferredLanguage   String?
  companySize         String?
  instagramHandle     String?
  tradeLicenseUrl     String?
  tradeLicenseFilename String?
  tradeLicenseUploadedAt DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingRequests     BookingRequest[]
  campaigns           Campaign[]
  creators            CreatorProfile[]
  creatorShopProjects CreatorShopProject[]
  walletTransactions  WalletTransaction[]

  @@index([userId])
  @@map("agency_accounts")
}

model CreatorProfile {
  id                          String                        @id @default(cuid())
  userId                      String?                       @unique
  agencyId                    String?
  name                        String
  instagram                   String?
  tiktok                      String?
  youtube                     String?
  bio                         String?
  hourlyRate                  Int?
  dayRate                     Int?
  skills                      String[]
  niches                      String[]
  location                    String?
  avatarUrl                   String?
  portfolioUrl                String?
  displayName                 String?
  fullName                    String?
  qualityScore                Int?
  talentStatus                String                        @default("pending")
  source                      String?
  isVerified                  Boolean                       @default(false)
  isActive                    Boolean                       @default(true)
  prismArchetype              String?
  prismArchetypeSecondary     String?
  primaryRole                 String?
  rankedIndustries            String[]                      @default([])
  yearsExperienceBand         String?
  preferredProjectTypes       String[]                      @default([])
  preferredPace               String?
  feedbackStyle               String?
  workEnvironmentFit          String?
  howIWorkBest                String?
  suitedTeamScale             String?
  availabilityType            String?
  workModeOpenness            String?
  brandFitPreferences         String[]                      @default([])
  clientValueStrengths        String[]                      @default([])
  teamSetupPreference         String?
  generatedMatchTags          String[]                      @default([])
  onboardingTranscriptJson    Json?
  onboardingAiSummary         String?                       @db.Text
  /** Optional freeform notes / deal-breakers after PRISM completion. */
  onboardingMatchNotes        String?                       @db.Text
  onboardingCompletedAt       DateTime?
  stripeAccountId             String?                       @unique
  stripeOnboardingStatus      StripeOnboardingStatus        @default(NOT_STARTED)
  availabilityStatus          String                        @default("AVAILABLE")
  profileViews                Int                           @default(0)
  totalEarned                 Int                           @default(0)
  responseRate                Float?
  avgResponseHours            Int?
  referralCode                String?                       @unique
  instagramVerified           Boolean                       @default(false)
  tiktokVerified              Boolean                       @default(false)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  invites                     CampaignInvite[]
  campaignPodSelectionConfigs CampaignPodSelectionConfig[]
  campaigns                   CampaignTalent[]
  contracts                   Contract[]
  opportunityPreference       CreatorOpportunityPreference?
  agency                      AgencyAccount?                @relation(fields: [agencyId], references: [id])
  user                        User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices                    Invoice[]
  messages                    Message[]                     @relation("CreatorMessages")
  portfolioItems              PortfolioItem[]
  walletTransactions          WalletTransaction[]

  @@index([userId])
  @@index([agencyId])
  @@index([instagram])
  @@index([isActive])
  @@index([availabilityStatus])
  @@map("creator_profiles")
}

model Campaign {
  id                          String                       @id @default(cuid())
  agencyId                    String
  title                       String
  brief                       String
  status                      CampaignStatus               @default(DRAFT)
  startDate                   DateTime?
  dueDate                     DateTime?
  budget                      Int?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  campaignBrief               CampaignBrief?
  files                       CampaignFile[]
  invites                     CampaignInvite[]
  metrics                     CampaignMetric[]
  payments                    CampaignPayment[]
  campaignPodSelectionConfigs CampaignPodSelectionConfig[]
  pod                         CampaignPod?
  talents                     CampaignTalent[]
  agency                      AgencyAccount                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invoices                    Invoice[]
  messages                    Message[]
  walletTransactions          WalletTransaction[]

  @@index([agencyId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignBrief {
  id                    String      @id @default(cuid())
  campaignId            String      @unique
  version               Int         @default(1)
  status                BriefStatus @default(DRAFT)
  isLocked              Boolean     @default(false)
  lockedAt              DateTime?
  sentAt                DateTime?
  lastEditedBy          String?
  lastEditedByName      String?
  primaryObjective      String?
  keyMessage            String?     @db.VarChar(280)
  creativeDirection     Json?
  mandatoryRequirements String?
  approvalRules         String?
  postingRules          String?
  attachmentIds         String[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  campaign              Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([isLocked])
  @@index([status])
  @@map("campaign_briefs")
}

model CampaignTalent {
  id         String               @id @default(cuid())
  campaignId String
  talentId   String
  status     CampaignTalentStatus @default(ASSIGNED)
  rate       Int?
  notes      String?
  assignedAt DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  campaign   Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  talent     CreatorProfile       @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, talentId])
  @@index([campaignId])
  @@index([talentId])
  @@index([status])
  @@map("campaign_talents")
}

model CampaignPod {
  id         String   @id @default(cuid())
  campaignId String   @unique
  talentIds  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_pods")
}

model CampaignInvite {
  id               String               @id @default(cuid())
  campaignId       String
  creatorProfileId String
  status           CampaignInviteStatus @default(PENDING)
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator          CreatorProfile       @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorProfileId])
  @@index([campaignId])
  @@index([creatorProfileId])
  @@map("campaign_invites")
}

model CampaignFile {
  id             String   @id @default(cuid())
  campaignId     String
  uploaderUserId String
  storageBucket  String
  storagePath    String   @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  createdAt      DateTime @default(now())
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploader       User     @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([uploaderUserId])
  @@map("campaign_files")
}

model CampaignMetric {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime
  views       Int      @default(0)
  reach       Int      @default(0)
  engagements Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([campaignId])
  @@index([date])
  @@map("campaign_metrics")
}

model CampaignPayment {
  id         String        @id @default(cuid())
  campaignId String
  amount     Decimal       @db.Decimal(12, 2)
  status     PaymentStatus @default(COMMITTED)
  dueDate    DateTime
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@index([dueDate])
  @@map("campaign_payments")
}

model WalletTransaction {
  id               String                @id @default(cuid())
  userId           String
  creatorProfileId String?
  agencyAccountId  String?
  campaignId       String?
  type             WalletTransactionType
  direction        WalletDirection
  amount           Int
  currency         String
  status           WalletStatus
  stripeObjectType String
  stripeObjectId   String
  metadata         Json?
  createdAt        DateTime              @default(now())
  agency           AgencyAccount?        @relation(fields: [agencyAccountId], references: [id])
  campaign         Campaign?             @relation(fields: [campaignId], references: [id])
  creator          CreatorProfile?       @relation(fields: [creatorProfileId], references: [id])
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([creatorProfileId])
  @@index([agencyAccountId])
  @@index([campaignId])
  @@index([stripeObjectId])
  @@map("wallet_transactions")
}

model BookingRequest {
  id           String         @id @default(cuid())
  userId       String
  agencyId     String?
  bookingType  BookingType    @default(SHORT)
  startDate    String?
  budgetRange  String?
  description  String
  contactEmail String
  talentIds    String[]
  status       BookingStatus  @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  agency       AgencyAccount? @relation(fields: [agencyId], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agencyId])
  @@map("booking_requests")
}

model DiscoveryBrief {
  id               String          @id @default(cuid())
  userId           String          @unique
  primaryObjective String?
  requestedRoles   String[]
  startTiming      String?
  budgetRange      String?
  companyName      String?
  industry         String?
  notes            String?
  /** Structured client workflow-fit answers (mirrors talent PRISM dimensions). */
  clientFitProfile Json?
  advisorRequested Boolean         @default(false)
  currentStep      Int             @default(0)
  status           DiscoveryStatus @default(INCOMPLETE)
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("discovery_briefs")
}

model AdvisorRequest {
  id              String   @id @default(cuid())
  userId          String
  contactMethod   String
  preferredTiming String
  note            String?
  source          String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("advisor_requests")
}

model PodSelection {
  id        String   @id @default(cuid())
  userId    String   @unique
  talentIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pod_selections")
}

model Message {
  id          String         @id @default(cuid())
  campaignId  String?
  senderId    String
  recipientId String?
  content     String
  isRead      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  campaign    Campaign?      @relation(fields: [campaignId], references: [id])
  sender      CreatorProfile @relation("CreatorMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
  @@map("messages")
}

model Invoice {
  id            String         @id @default(cuid())
  campaignId    String?
  talentId      String
  agencyId      String?
  amount        Int
  currency      String         @default("USD")
  status        InvoiceStatus  @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  invoiceNumber String         @unique
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  talent        CreatorProfile @relation(fields: [talentId], references: [id], onDelete: Cascade)
  transaction   Transaction?

  @@index([campaignId])
  @@index([talentId])
  @@index([agencyId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model Transaction {
  id          String            @id @default(cuid())
  invoiceId   String?           @unique
  amount      Int
  currency    String            @default("USD")
  type        TransactionType
  status      TransactionStatus @default(PENDING)
  description String?
  metadata    Json?
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("transactions")
}

model PortfolioItem {
  id               String         @id @default(cuid())
  creatorProfileId String
  title            String?
  caption          String?
  mediaUrl         String
  mediaType        String         @default("image")
  thumbnailUrl     String?
  position         Int            @default(0)
  externalLink     String?
  platform         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId])
  @@map("portfolio_items")
}

model Contract {
  id               String         @id @default(cuid())
  campaignId       String?
  creatorProfileId String
  agencyId         String?
  title            String
  content          String
  status           ContractStatus @default(DRAFT)
  totalAmount      Int?
  currency         String         @default("AED")
  agencySignedAt   DateTime?
  creatorSignedAt  DateTime?
  agencySignature  String?
  creatorSignature String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  milestones       Milestone[]

  @@index([campaignId])
  @@index([creatorProfileId])
  @@map("contracts")
}

model Milestone {
  id              String          @id @default(cuid())
  contractId      String
  title           String
  description     String?
  amount          Int
  currency        String          @default("AED")
  dueDate         DateTime?
  status          MilestoneStatus @default(PENDING)
  fundedAt        DateTime?
  releasedAt      DateTime?
  completedAt     DateTime?
  submissionNote  String?
  submissionFiles String[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("milestones")
}

model CreatorOpportunityPreference {
  id               String         @id @default(cuid())
  creatorProfileId String         @unique
  interestedRoles  String[]
  interestedNiches String[]
  minRate          Int?
  openToLongTerm   Boolean        @default(true)
  openToShortTerm  Boolean        @default(true)
  preferredBrands  String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([creatorProfileId])
  @@map("creator_opportunity_preferences")
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referredEmail  String
  referredUserId String?
  code           String         @unique
  status         ReferralStatus @default(PENDING)
  rewardAmount   Int            @default(0)
  rewardPaidAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

/// Execution project for creator-led product launch or growth — not native storefront / checkout.
model CreatorShopProject {
  id                   String                   @id @default(cuid())
  ownerUserId          String
  agencyId             String?
  mode                 CreatorShopProjectMode
  productType          String
  title                String
  status               CreatorShopProjectStatus @default(DRAFT)
  /// Full intake payload (launch vs grow fields); source of truth for brief details.
  briefPayload         Json
  budgetBand           String?
  desiredLaunchDate    DateTime?
  currentPlatform      String?
  audienceContext      String?
  notes                String?
  /// Timeline entries: [{ "status": "...", "at": "ISO", "label"?: "..." }]
  statusHistory        Json?
  commercialModelNotes String?
  latestUpdateAt       DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  agency               AgencyAccount?           @relation(fields: [agencyId], references: [id])
  owner                User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([agencyId])
  @@index([status])
  @@index([createdAt])
  @@map("creator_shop_projects")
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String?
  ipKey     String?
  feature   String
  day       String
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, feature, day])
  @@unique([ipKey, feature, day])
  @@index([userId])
  @@index([ipKey])
  @@index([day])
  @@map("ai_usage")
}

model EditorialSource {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  feedUrl     String
  siteUrl     String
  category    String                @default("fashion")
  tags        String[]              @default([])
  tier        String                @default("primary")
  status      EditorialSourceStatus @default(ACTIVE)
  lastFetchAt DateTime?
  lastError   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       EditorialItem[]
  runs        EditorialRun[]

  @@map("editorial_sources")
}

model EditorialItem {
  id           String              @id @default(cuid())
  sourceId     String
  canonicalUrl String              @unique
  title        String
  excerpt      String?
  imageUrl     String?
  author       String?
  publishedAt  DateTime?
  category     String?
  tags         String[]            @default([])
  aiSummary    String?
  aiRelevance  Float?
  aiTone       String?
  duplicateOf  String?
  status       EditorialItemStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  source       EditorialSource     @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([status])
  @@index([publishedAt])
  @@index([category])
  @@map("editorial_items")
}

model EditorialRun {
  id           String          @id @default(cuid())
  sourceId     String
  startedAt    DateTime        @default(now())
  finishedAt   DateTime?
  itemsFound   Int             @default(0)
  itemsNew     Int             @default(0)
  itemsSkipped Int             @default(0)
  error        String?
  createdAt    DateTime        @default(now())
  source       EditorialSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([startedAt])
  @@map("editorial_runs")
}

enum HireType {
  PROJECT
  MONTHLY
  HOURLY
}

enum UsageRightsTier {
  NONE
  STANDARD
  FULL
  BUYOUT
}

enum UserRole {
  AGENCY
  CREATOR
  ADMIN
}

enum CampaignStatus {
  PROVISIONAL
  CONFIRMED_BRIEF_PENDING
  BRIEF_SENT
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
  DRAFT
  ACTIVE
}

enum CampaignTalentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionType {
  PAYMENT
  REFUND
  FEE
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum BookingType {
  SHORT
  LONG
}

enum BookingStatus {
  PENDING
  REVIEWING
  CONFIRMED
}

enum DiscoveryStatus {
  INCOMPLETE
  COMPLETE
}

enum CampaignInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum StripeOnboardingStatus {
  NOT_STARTED
  PENDING
  COMPLETE
}

enum WalletTransactionType {
  PAYMENT_INTENT
  TRANSFER
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum WalletDirection {
  CREDIT
  DEBIT
}

enum WalletStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PaymentStatus {
  COMMITTED
  INVOICED
  PAID
}

enum BriefStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  AGENCY_SIGNED
  FULLY_SIGNED
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
