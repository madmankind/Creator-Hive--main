// src/app/page.tsx - Inline briefing (content replacement, no panels/modals)
"use client";

import { useState, useEffect } from "react";
import { HeroBar } from "@/components/HeroBar";
import { TalentCarousel } from "@/components/marketing/TalentCarousel";
import { ClientAuthDialog } from "@/components/auth/ClientAuthDialog";
import { TalentOnboardingDialogFey } from "@/components/auth/TalentOnboardingDialogFey";
import { PodSetupOverlay } from "@/features/pod-setup/PodSetupOverlay";
import { curatedTalent } from "@/lib/curatedTalent";
import { useSession } from "next-auth/react";
import { cn } from "@/lib/utils";

// ─── Inline booking schema (no external imports) ───
const OBJECTIVE_CONFIG: Record<string, { label: string; description: string; icon: string }> = {
  brand_awareness: {
    label: "Brand Awareness",
    description: "Increase visibility and recognition across target markets",
    icon: "📈",
  },
  audience_growth: {
    label: "Audience Growth",
    description: "Build larger, more engaged community",
    icon: "👥",
  },
  drive_conversions: {
    label: "Drive Conversions",
    description: "Generate sales, leads, and measurable ROI",
    icon: "💰",
  },
  product_launch: {
    label: "Product Launch",
    description: "Introduce new offering with maximum impact",
    icon: "🚀",
  },
};

const OUTPUT_TYPES = [
  "UGC",
  "Edited video",
  "Photo shoot",
  "Social management",
  "Design",
  "Performance",
  "Web build",
];

const PLATFORMS = ["TikTok", "Instagram", "YouTube", "Snapchat", "LinkedIn", "X"];

const MARKETS = ["UAE", "Saudi Arabia", "Egypt", "Qatar", "Kuwait", "Bahrain", "Oman", "Lebanon", "Jordan"];

const TIMELINE_OPTIONS: Record<string, string> = {
  asap: "ASAP",
  this_month: "This month",
  next_month: "Next month",
  flexible: "Flexible",
};

const curatedLookup = new Map(curatedTalent.map((t) => [t.id, t]));

export default function HomePage() {
  const [mode, setMode] = useState<"client" | "talent">("client");
  const [showTalentGallery, setShowTalentGallery] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedRoles, setSelectedRoles] = useState<string[]>([]);
  const [clientAuthOpen, setClientAuthOpen] = useState(false);
  const [talentAuthOpen, setTalentAuthOpen] = useState(false);
  const [pendingDiscover, setPendingDiscover] = useState(false);

  // Briefing state - replaces old modal/panel approach
  const [showBriefing, setShowBriefing] = useState(false);
  const [currentStep, setCurrentStep] = useState(1);

  // Brief form state
  const [objective, setObjective] = useState("");
  const [outputs, setOutputs] = useState<string[]>([]);
  const [platforms, setPlatforms] = useState<string[]>([]);
  const [markets, setMarkets] = useState<string[]>([]);
  const [timeline, setTimeline] = useState("");
  const [companyName, setCompanyName] = useState("");
  const [contactEmail, setContactEmail] = useState("");
  const [contactPhone, setContactPhone] = useState("");
  const [requestNote, setRequestNote] = useState("");
  const [submitting, setSubmitting] = useState(false);
  const [submitError, setSubmitError] = useState<string | null>(null);

  // Pod state
  const [selectedPodIds, setSelectedPodIds] = useState<string[]>([]);

  const { data: session } = useSession();
  const role = (session?.user as { role?: string | null } | undefined)?.role ?? null;
  const isClient = role === "AGENCY";

  const selectedTalents = selectedPodIds
    .map((id) => curatedLookup.get(id))
    .filter(Boolean)
    .map((t) => ({ id: t!.id, name: t!.name }));

  const toggle = (arr: string[], setArr: (v: string[]) => void, v: string) =>
    setArr(arr.includes(v) ? arr.filter((x) => x !== v) : [...arr, v]);

  const canProceed = () => {
    if (currentStep === 1) return objective.length > 0;
    if (currentStep === 2) return outputs.length > 0 && platforms.length > 0;
    if (currentStep === 3) return markets.length > 0 && timeline.length > 0;
    return false;
  };

  const canSubmit = () => companyName.trim().length > 0 && contactEmail.trim().length > 0;

  // Load landing pod from localStorage
  useEffect(() => {
    try {
      const stored = localStorage.getItem("ch_landing_pod_ids");
      if (stored) {
        const parsed = JSON.parse(stored);
        if (Array.isArray(parsed)) setSelectedPodIds(parsed);
      }
    } catch { /* ignore */ }
  }, []);

  useEffect(() => {
    if (selectedPodIds.length > 0) {
      localStorage.setItem("ch_landing_pod_ids", JSON.stringify(selectedPodIds));
    } else {
      localStorage.removeItem("ch_landing_pod_ids");
    }
  }, [selectedPodIds]);

  const addToPod = (talentId: string) => {
    setSelectedPodIds((prev) => (prev.includes(talentId) ? prev : [...prev, talentId]));
  };
  const removeFromPod = (talentId: string) => {
    setSelectedPodIds((prev) => prev.filter((id) => id !== talentId));
  };

  const clearPod = () => {
    setSelectedPodIds([]);
    setShowBriefing(false);
    setCurrentStep(1);
    setObjective("");
    setOutputs([]);
    setPlatforms([]);
    setMarkets([]);
    setTimeline("");
    setCompanyName("");
    setContactEmail("");
    setContactPhone("");
    setRequestNote("");
    setSubmitError(null);
  };

  const handleSetupCampaign = () => {
    if (selectedPodIds.length === 0) return;
    if (!session?.user || !isClient) {
      setPendingDiscover(true);
      setClientAuthOpen(true);
      return;
    }
    setShowTalentGallery(true);
    setShowBriefing(true);
    setCurrentStep(1);
  };

  const prevStep = () => {
    if (currentStep > 1) {
      setCurrentStep(currentStep - 1);
    } else {
      setShowBriefing(false);
      setCurrentStep(1);
    }
  };

  const nextStep = () => {
    if (currentStep < 4 && canProceed()) {
      setCurrentStep(currentStep + 1);
    } else if (currentStep === 4 && canSubmit()) {
      handleSubmitRequest();
    }
  };

  const handleSubmitRequest = async () => {
    if (!canSubmit() || submitting) return;
    setSubmitting(true);
    setSubmitError(null);
    try {
      const response = await fetch("/api/booking/request", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          objective,
          outputs,
          platforms,
          markets,
          timeline,
          companyName: companyName.trim(),
          contactEmail: contactEmail.trim(),
          contactPhone: contactPhone.trim() || undefined,
          requestNote: requestNote.trim() || undefined,
          selectedTalentIds: selectedPodIds,
        }),
      });
      if (!response.ok) throw new Error("Failed to submit request");
      clearPod();
      setShowBriefing(false);
      setCurrentStep(1);
    } catch (err) {
      setSubmitError(err instanceof Error ? err.message : "Failed to submit");
    } finally {
      setSubmitting(false);
    }
  };

  useEffect(() => {
    if (isClient && pendingDiscover) {
      setShowTalentGallery(true);
      setTimeout(() => {
        document.getElementById("talent-gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
      }, 150);
      setPendingDiscover(false);
    }
  }, [isClient, pendingDiscover]);

  useEffect(() => {
    if (showBriefing) setShowTalentGallery(true);
  }, [showBriefing]);

  return (
    <main className="min-h-screen bg-[#0B0F14] text-slate-200">
      <div className="pointer-events-none fixed inset-0 flex items-start justify-center">
        <div className="mt-8 h-[40vh] w-[60vw] max-w-[900px] blur-3xl opacity-[0.16] bg-gradient-to-b from-white/25 via-white/10 to-transparent rounded-full" />
      </div>

      <div className="relative flex items-center justify-center min-h-screen px-6">
        <div className="w-full max-w-[1100px]">
          <div className="text-center space-y-6 mb-12">
            <h1 className="text-[32px] md:text-[40px] font-semibold tracking-[-0.02em] text-white/90">
              Welcome to Creator Hive
            </h1>
            <div className="inline-flex items-center gap-1 rounded-full bg-white/5 p-1 ring-1 ring-white/10">
              <button
                onClick={() => setMode("client")}
                className={cn(
                  "px-3.5 py-1.5 rounded-full text-[12px] font-medium transition",
                  mode === "client" ? "bg-white/10 text-white ring-1 ring-white/15" : "text-white/60 hover:text-white"
                )}
              >
                Client
              </button>
              <button
                onClick={() => setMode("talent")}
                className={cn(
                  "px-3.5 py-1.5 rounded-full text-[12px] font-medium transition",
                  mode === "talent" ? "bg-white/10 text-white ring-1 ring-white/15" : "text-white/60 hover:text-white"
                )}
              >
                Talent
              </button>
            </div>
            <p className="text-[14px] text-white/60">
              {mode === "client"
                ? "Book Top 1% talent seamlessly"
                : "Join the Hive to showcase your work and get discovered."}
            </p>
            {mode === "client" && (
              <p className="text-[13px] text-white/50 mt-2">
                Describe your campaign and choose the roles you need – we&apos;ll surface curated talent that fits.
              </p>
            )}
          </div>

          <div className="flex justify-center">
            <div className="w-full max-w-[860px]">
              <HeroBar
                mode={mode}
                onQueryChange={(q) => setSearchQuery(q)}
                onRolesChange={(roles) => setSelectedRoles(roles)}
                onDiscover={() => {
                  if (!session?.user) {
                    if (mode === "client") {
                      setPendingDiscover(true);
                      setClientAuthOpen(true);
                    } else setTalentAuthOpen(true);
                    return;
                  }
                  if (mode === "client" && !isClient) {
                    setPendingDiscover(true);
                    setClientAuthOpen(true);
                    return;
                  }
                  setShowTalentGallery(true);
                  setTimeout(() => {
                    document.getElementById("talent-gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
                  }, 100);
                }}
                onOpenBriefBuilder={() => {
                  if (mode === "client" && !isClient) {
                    setClientAuthOpen(true);
                    return;
                  }
                  setShowTalentGallery(true);
                  setShowBriefing(true);
                  setCurrentStep(1);
                }}
              />
            </div>
          </div>
        </div>
      </div>

      {/* SINGLE CONTENT AREA - conditional rendering (same space) */}
      {mode === "client" && showTalentGallery && (
        <div className="max-w-7xl mx-auto px-6 pb-20" data-section="discovery">
          {/* DISCOVERY MODE: talent carousel */}
          {!showBriefing && (
            <>
              <section id="talent-gallery" className="mt-20 md:mt-28">
                <TalentCarousel
                  talents={curatedTalent}
                  query={searchQuery}
                  selectedRoles={selectedRoles}
                  selectedPodIds={selectedPodIds}
                  onAddToPod={addToPod}
                  onBook={(talent) => {
                    if (!selectedPodIds.includes(talent.id)) addToPod(talent.id);
                    setShowBriefing(true);
                    setCurrentStep(1);
                  }}
                  onTalentClick={(talentId) => {
                    if (selectedPodIds.includes(talentId)) removeFromPod(talentId);
                    else addToPod(talentId);
                  }}
                />
              </section>

              {/* Pod tray - only in discovery mode when talents selected */}
              {selectedPodIds.length > 0 && (
                <div className="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 w-[min(560px,92vw)]">
                  <div className="bg-white/[0.05] backdrop-blur-xl border border-white/[0.08] rounded-2xl p-6 shadow-2xl ring-1 ring-white/[0.08]">
                    <div className="text-center mb-4">
                      <h3 className="text-lg font-light text-white/90 mb-2">Campaign Pod</h3>
                      <div className="flex justify-center gap-2 mb-4 flex-wrap">
                        {selectedTalents.map((t) => (
                          <div
                            key={t.id}
                            className="w-8 h-8 rounded-full bg-gradient-to-br from-white/20 to-white/10 flex items-center justify-center text-xs text-white/70"
                          >
                            {t.name[0]}
                          </div>
                        ))}
                      </div>
                      <div className="flex gap-3 justify-center">
                        <button
                          type="button"
                          onClick={clearPod}
                          className="px-4 py-2 text-sm font-light text-white/60 hover:text-white/90 transition-colors"
                        >
                          Clear
                        </button>
                        <button
                          type="button"
                          onClick={handleSetupCampaign}
                          className="px-6 py-3 bg-white text-black rounded-xl font-medium hover:bg-white/90 transition-colors backdrop-blur-sm"
                        >
                          Set up campaign
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              )}
            </>
          )}

          {/* BRIEFING MODE: same space as talent cards */}
          {showBriefing && (
            <div className="space-y-12 mt-20 md:mt-28">
              <div className="text-center">
                <h2 className="text-3xl font-light text-white/90 mb-4">Campaign Brief</h2>
                <p className="text-white/60 font-light mb-6">Configure your campaign with selected talent</p>
                <div className="flex justify-center items-center gap-4 mb-8 flex-wrap">
                  <span className="text-sm text-white/50">Selected:</span>
                  {selectedTalents.map((t) => (
                    <div
                      key={t.id}
                      className="flex items-center gap-2 px-3 py-1.5 bg-white/[0.08] backdrop-blur-sm rounded-full text-xs text-white/70 border border-white/[0.06]"
                    >
                      <div className="w-6 h-6 rounded-full bg-gradient-to-br from-white/20 to-white/10 flex items-center justify-center text-[10px]">
                        {t.name[0]}
                      </div>
                      {t.name}
                    </div>
                  ))}
                </div>
              </div>

              <div className="max-w-4xl mx-auto">
                {/* Step 1: Campaign Objective */}
                {currentStep === 1 && (
                  <div className="text-center space-y-8">
                    <div>
                      <h3 className="text-2xl font-light text-white/90 mb-3">Campaign Objective</h3>
                      <p className="text-white/60 font-light">Select your primary marketing goal</p>
                    </div>
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                      {Object.entries(OBJECTIVE_CONFIG).map(([key, { label, description, icon }]) => (
                        <button
                          key={key}
                          type="button"
                          onClick={() => setObjective(key)}
                          className={cn(
                            "group p-8 rounded-2xl text-left transition-all border backdrop-blur-sm",
                            objective === key
                              ? "bg-white/[0.12] border-white/[0.20] ring-1 ring-white/[0.08]"
                              : "bg-white/[0.03] hover:bg-white/[0.08] border-white/[0.06] hover:border-white/[0.12]"
                          )}
                        >
                          <div className="flex items-start gap-4">
                            <div className="w-12 h-12 rounded-xl bg-white/[0.08] group-hover:bg-white/[0.15] flex items-center justify-center text-lg transition-colors">
                              {icon}
                            </div>
                            <div>
                              <h4 className="text-lg font-medium text-white/90 group-hover:text-white mb-2">{label}</h4>
                              <p className="text-sm text-white/50 group-hover:text-white/70 leading-relaxed font-light">
                                {description}
                              </p>
                            </div>
                          </div>
                        </button>
                      ))}
                    </div>
                  </div>
                )}

                {/* Step 2: Content & Platforms */}
                {currentStep === 2 && (
                  <div className="text-center space-y-8">
                    <div>
                      <h3 className="text-2xl font-light text-white/90 mb-3">Content & Platforms</h3>
                      <p className="text-white/60 font-light">What deliverables do you need and where will they be published?</p>
                    </div>
                    <div className="space-y-8">
                      <div>
                        <h4 className="text-lg font-medium text-white/90 mb-4 text-left">Content Outputs</h4>
                        <div className="flex flex-wrap gap-3">
                          {OUTPUT_TYPES.map((out) => {
                            const sel = outputs.includes(out);
                            return (
                              <button
                                key={out}
                                type="button"
                                onClick={() => toggle(outputs, setOutputs, out)}
                                className={cn(
                                  "px-4 py-2 rounded-xl text-sm font-light transition-all border backdrop-blur-sm",
                                  sel
                                    ? "bg-white/[0.12] text-white border-white/[0.20]"
                                    : "bg-white/[0.05] hover:bg-white/[0.12] text-white/80 hover:text-white border-white/[0.08] hover:border-white/[0.15]"
                                )}
                              >
                                {out}
                              </button>
                            );
                          })}
                        </div>
                      </div>
                      <div>
                        <h4 className="text-lg font-medium text-white/90 mb-4 text-left">Platforms</h4>
                        <div className="flex flex-wrap gap-3">
                          {PLATFORMS.map((plat) => {
                            const sel = platforms.includes(plat);
                            return (
                              <button
                                key={plat}
                                type="button"
                                onClick={() => toggle(platforms, setPlatforms, plat)}
                                className={cn(
                                  "px-4 py-2 rounded-xl text-sm font-light transition-all border backdrop-blur-sm",
                                  sel
                                    ? "bg-white/[0.12] text-white border-white/[0.20]"
                                    : "bg-white/[0.05] hover:bg-white/[0.12] text-white/80 hover:text-white border-white/[0.08] hover:border-white/[0.15]"
                                )}
                              >
                                {plat}
                              </button>
                            );
                          })}
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {/* Step 3: Markets & Timeline */}
                {currentStep === 3 && (
                  <div className="text-center space-y-8">
                    <div>
                      <h3 className="text-2xl font-light text-white/90 mb-3">Markets & Timeline</h3>
                      <p className="text-white/60 font-light">Select target markets and campaign timeline</p>
                    </div>
                    <div className="grid md:grid-cols-2 gap-8">
                      <div>
                        <h4 className="text-lg font-medium text-white/90 mb-4 text-left">Target Markets</h4>
                        <div className="flex flex-wrap gap-3">
                          {MARKETS.map((m) => {
                            const sel = markets.includes(m);
                            return (
                              <button
                                key={m}
                                type="button"
                                onClick={() => toggle(markets, setMarkets, m)}
                                className={cn(
                                  "px-4 py-2 rounded-xl text-sm font-light transition-all border backdrop-blur-sm",
                                  sel
                                    ? "bg-white/[0.12] text-white border-white/[0.20]"
                                    : "bg-white/[0.05] hover:bg-white/[0.12] text-white/80 hover:text-white border-white/[0.08] hover:border-white/[0.15]"
                                )}
                              >
                                {m}
                              </button>
                            );
                          })}
                        </div>
                      </div>
                      <div>
                        <h4 className="text-lg font-medium text-white/90 mb-4 text-left">Timeline</h4>
                        <div className="space-y-3">
                          {Object.entries(TIMELINE_OPTIONS).map(([key, label]) => (
                            <button
                              key={key}
                              type="button"
                              onClick={() => setTimeline(key)}
                              className={cn(
                                "w-full p-3 text-left rounded-xl text-sm font-light transition-all border backdrop-blur-sm",
                                timeline === key
                                  ? "bg-white/[0.12] text-white border-white/[0.20]"
                                  : "bg-white/[0.03] hover:bg-white/[0.08] text-white/80 hover:text-white border-white/[0.06] hover:border-white/[0.12]"
                              )}
                            >
                              {label}
                            </button>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {/* Step 4: Review & Contact */}
                {currentStep === 4 && (
                  <div className="space-y-8">
                    <div className="text-center">
                      <h3 className="text-2xl font-light text-white/90 mb-3">Review & Submit</h3>
                      <p className="text-white/60 font-light">Confirm your campaign details and provide contact information</p>
                    </div>
                    <div className="grid md:grid-cols-2 gap-8">
                      <div className="p-6 bg-white/[0.03] backdrop-blur-sm border border-white/[0.06] rounded-2xl">
                        <h4 className="text-lg font-medium text-white/90 mb-4">Campaign Summary</h4>
                        <div className="space-y-3 text-sm font-light">
                          {objective && (
                            <div className="flex justify-between py-2 border-b border-white/[0.06]">
                              <span className="text-white/50">Objective</span>
                              <span className="text-white/90">{OBJECTIVE_CONFIG[objective]?.label ?? objective}</span>
                            </div>
                          )}
                          <div className="flex justify-between py-2 border-b border-white/[0.06]">
                            <span className="text-white/50">Outputs</span>
                            <span className="text-white/90">{outputs.join(", ")}</span>
                          </div>
                          <div className="flex justify-between py-2 border-b border-white/[0.06]">
                            <span className="text-white/50">Platforms</span>
                            <span className="text-white/90">{platforms.join(", ")}</span>
                          </div>
                          <div className="flex justify-between py-2 border-b border-white/[0.06]">
                            <span className="text-white/50">Markets</span>
                            <span className="text-white/90">{markets.join(", ")}</span>
                          </div>
                          {timeline && (
                            <div className="flex justify-between py-2">
                              <span className="text-white/50">Timeline</span>
                              <span className="text-white/90">{TIMELINE_OPTIONS[timeline] ?? timeline}</span>
                            </div>
                          )}
                        </div>
                      </div>
                      <div className="p-6 bg-white/[0.03] backdrop-blur-sm border border-white/[0.06] rounded-2xl">
                        <h4 className="text-lg font-medium text-white/90 mb-4">Contact Information</h4>
                        <div className="space-y-4">
                          <input
                            type="text"
                            placeholder="Company name *"
                            value={companyName}
                            onChange={(e) => setCompanyName(e.target.value)}
                            className="w-full px-4 py-3 bg-white/[0.03] border border-white/[0.08] focus:border-white/[0.15] rounded-xl text-white/90 placeholder-white/40 font-light focus:outline-none transition-colors"
                          />
                          <input
                            type="email"
                            placeholder="Email *"
                            value={contactEmail}
                            onChange={(e) => setContactEmail(e.target.value)}
                            className="w-full px-4 py-3 bg-white/[0.03] border border-white/[0.08] focus:border-white/[0.15] rounded-xl text-white/90 placeholder-white/40 font-light focus:outline-none transition-colors"
                          />
                          <input
                            type="tel"
                            placeholder="Phone (optional)"
                            value={contactPhone}
                            onChange={(e) => setContactPhone(e.target.value)}
                            className="w-full px-4 py-3 bg-white/[0.03] border border-white/[0.08] focus:border-white/[0.15] rounded-xl text-white/90 placeholder-white/40 font-light focus:outline-none transition-colors"
                          />
                          <textarea
                            placeholder="Additional requirements..."
                            value={requestNote}
                            onChange={(e) => setRequestNote(e.target.value)}
                            className="w-full px-4 py-3 bg-white/[0.03] border border-white/[0.08] focus:border-white/[0.15] rounded-xl text-white/90 placeholder-white/40 font-light focus:outline-none transition-colors h-24 resize-none"
                          />
                        </div>
                        {submitError && (
                          <p className="mt-3 text-sm text-red-400 font-light">{submitError}</p>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* Navigation - inline within same space */}
              <div className="flex justify-center">
                <div className="flex items-center gap-8 px-8 py-4 bg-white/[0.03] backdrop-blur-sm border border-white/[0.06] rounded-2xl">
                  <button
                    type="button"
                    onClick={prevStep}
                    className="text-white/60 hover:text-white/90 font-light transition-colors"
                  >
                    {currentStep > 1 ? "Back" : "Close"}
                  </button>
                  <div className="flex gap-2">
                    {[1, 2, 3, 4].map((step) => (
                      <div
                        key={step}
                        className={cn(
                          "w-2 h-2 rounded-full transition-all",
                          currentStep >= step ? "bg-white/80" : "bg-white/20"
                        )}
                      />
                    ))}
                  </div>
                  {currentStep < 4 ? (
                    <button
                      type="button"
                      onClick={nextStep}
                      disabled={!canProceed()}
                      className={cn(
                        "px-6 py-2 rounded-xl font-medium text-sm transition-colors backdrop-blur-sm",
                        canProceed()
                          ? "bg-white text-black hover:bg-white/90"
                          : "bg-white/10 text-white/30 cursor-not-allowed"
                      )}
                    >
                      Continue
                    </button>
                  ) : (
                    <button
                      type="button"
                      onClick={handleSubmitRequest}
                      disabled={!canSubmit() || submitting}
                      className={cn(
                        "px-6 py-2 rounded-xl font-medium text-sm transition-colors backdrop-blur-sm",
                        canSubmit() && !submitting
                          ? "bg-white text-black hover:bg-white/90"
                          : "bg-white/10 text-white/30 cursor-not-allowed"
                      )}
                    >
                      {submitting ? "Submitting…" : "Submit Campaign"}
                    </button>
                  )}
                </div>
              </div>
            </div>
          )}
        </div>
      )}

      <PodSetupOverlay />

      <ClientAuthDialog
        open={clientAuthOpen}
        onClose={() => {
          setClientAuthOpen(false);
          setPendingDiscover(false);
        }}
        onSuccess={() => {
          if (pendingDiscover) {
            const hasPodIds = selectedPodIds.length > 0;
            if (hasPodIds) {
              setShowTalentGallery(true);
              setShowBriefing(true);
              setCurrentStep(1);
            } else {
              setShowTalentGallery(true);
              setTimeout(() => {
                document.getElementById("talent-gallery")?.scrollIntoView({ behavior: "smooth", block: "start" });
              }, 150);
            }
            setPendingDiscover(false);
          }
        }}
      />

      <TalentOnboardingDialogFey open={talentAuthOpen} onClose={() => setTalentAuthOpen(false)} onSuccess={() => {}} />

      <footer className="mt-16 border-t border-white/10 pt-4 pb-6 text-center">
        <p className="text-[11px] text-white/45">Creator Hive is human-first. Please clearly label any AI-generated media.</p>
      </footer>
    </main>
  );
}
