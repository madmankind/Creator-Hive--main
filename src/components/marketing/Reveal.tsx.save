nano Reveal.tsx
"use client";
import { motion, Variants } from "framer-motion";
import { ReactNode } from "react";

const defaultVariants: Variants = {
  hidden: { opacity: 0, y: 16 },
  visible: { opacity: 1, y: 0, transition: { duration: 0.5, ease: [0.22, 1, 0.36, 1] } },
};

export function Reveal({ children, className = "", variants = defaultVariants, as = "div" as const }: { children: ReactNode; className?: string; variants?: Variants; as?: keyof JSX.IntrinsicElements }) {
  const Comp = as as keyof JSX.IntrinsicElements;
  return (
    <motion.div
      className={className}
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true, margin: "-10% 0px" }}
      variants={{}}
    >
      <motion.div variants={variants}>
        {children}
      </motion.div>
    </motion.div>
  );
}


